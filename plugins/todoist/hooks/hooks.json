{
  "description": "把 Codex 的 update_plan 计划自动同步到 Todoist，并在每轮结束时兜底同步本会话计划",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(update_plan|plan)$",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "todoist",
            "tool": "todoist_sync_plan_from_hook",
            "input": {
              "steps": "${tool_input.plan}",
              "raw": "${tool_input}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 20,
            "statusMessage": "同步计划到 Todoist"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "todoist",
            "tool": "todoist_sync_plan_from_text",
            "input": {
              "text": "${prompt}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 20,
            "statusMessage": "同步本轮计划到 Todoist"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "todoist",
            "tool": "todoist_sync_plan_from_text",
            "input": {
              "text": "${last_assistant_message}",
              "session_id": "${session_id}",
              "turn_id": "${turn_id}"
            },
            "timeout": 20,
            "statusMessage": "同步本会话计划到 Todoist"
          }
        ]
      }
    ]
  }
}